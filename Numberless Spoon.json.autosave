"elevation":40.0,"intensity":0.33,"rotation":300.0},"stringParameters":{"groundColor":"127;127;127","skyColor":"255;255;255","top":"Z+"},"booleanParameters":{}},{"effectType":"Scene3D::DirectionalLight","name":"3D Sun Light","doubleParameters":{"distanceFromCamera":1500.0,"elevation":40.0,"frustumSize":4000.0,"intensity":0.75,"minimumShadowBias":0.0,"rotation":300.0},"stringParameters":{"color":"255;255;255","shadowQuality":"medium","top":"Z+"},"booleanParameters":{"isCastingShadow":true}}]}],"behaviorsSharedData":[{"name":"Animation","type":"AnimatableCapability::AnimatableBehavior"},{"name":"Effect","type":"EffectCapability::EffectBehavior"},{"name":"Flippable","type":"FlippableCapability::FlippableBehavior"},{"name":"Opacity","type":"OpacityCapability::OpacityBehavior"},{"name":"Platform","type":"PlatformBehavior::PlatformBehavior"},{"name":"PlatformerObject","type":"PlatformBehavior::PlatformerObjectBehavior"},{"name":"Resizable","type":"ResizableCapability::ResizableBehavior"},{"name":"Scale","type":"ScalableCapability::ScalableBehavior"}]}],"externalEvents":[],"tests":[{"description":"Verifies the main character can move right, jump and fall using the default platformer controls.","lastRunAt":1787085917120.0,"lastRunDurationMs":286.0,"lastRunFramesExecuted":287,"lastRunStatus":"passed","name":"MainCharacter platformer movement","type":"gameplay","source":["await harness.goToScene('Untitled scene');","","// Probe horizontal movement (character starts in the air, so jump is tested separately).","const probe = await harness.resetSceneAndProbeControls('MainCharacter', ['Right', 'Left']);","harness.assert(probe.keys['Right'] && probe.keys['Right'].dx > 0, 'Right key moves the character right');","harness.assert(probe.keys['Left'] && probe.keys['Left'].dx < 0, 'Left key moves the character left');","","// Let the character fall and land on the ground.","await harness.stepFrames(150);","const startY = harness.getObjects('MainCharacter')[0].y;","","// Jump and verify it rises then falls back down.","harness.setKeyPressed('Space', true);","await harness.stepFrames(6);","harness.setKeyPressed('Space', false);","const peakY = harness.getObjects('MainCharacter')[0].y;","harness.assert(peakY < startY - 20, 'Character rises during jump (peakY ' + peakY + ' < startY ' + startY + ')');","","const landed = await harness.stepUntil(() => {","  const c = harness.getObjects('MainCharacter')[0];","  return c.y >= startY - 5;","}, { maxFrames: 180 });","harness.assert(landed, 'Character falls back down to the ground after jumping');"]}],"eventsFunctionsExtensions":[],"externalLayouts":[]}