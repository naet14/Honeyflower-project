  "tests": [
    {
      "description": "Verifies the main character can move right, jump and fall using the default platformer controls.",
      "lastRunAt": 1787085917120,
      "lastRunDurationMs": 286,
      "lastRunFramesExecuted": 287,
      "lastRunStatus": "passed",
      "name": "MainCharacter platformer movement",
      "type": "gameplay",
      "source": [
        "await harness.goToScene('Untitled scene');",
        "",
        "// Probe horizontal movement (character starts in the air, so jump is tested separately).",
        "const probe = await harness.resetSceneAndProbeControls('MainCharacter', ['Right', 'Left']);",
        "harness.assert(probe.keys['Right'] && probe.keys['Right'].dx > 0, 'Right key moves the character right');",
        "harness.assert(probe.keys['Left'] && probe.keys['Left'].dx < 0, 'Left key moves the character left');",
        "",
        "// Let the character fall and land on the ground.",
        "await harness.stepFrames(150);",
        "const startY = harness.getObjects('MainCharacter')[0].y;",
        "",
        "// Jump and verify it rises then falls back down.",
        "harness.setKeyPressed('Space', true);",
        "await harness.stepFrames(6);",
        "harness.setKeyPressed('Space', false);",
        "const peakY = harness.getObjects('MainCharacter')[0].y;",
        "harness.assert(peakY < startY - 20, 'Character rises during jump (peakY ' + peakY + ' < startY ' + startY + ')');",
        "",
        "const landed = await harness.stepUntil(() => {",
        "  const c = harness.getObjects('MainCharacter')[0];",
        "  return c.y >= startY - 5;",
        "}, { maxFrames: 180 });",
        "harness.assert(landed, 'Character falls back down to the ground after jumping');"
      ]
    }
  ],
